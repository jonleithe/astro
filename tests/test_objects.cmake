function(run_case objects sun moon)
    execute_process(COMMAND "${ASTRO}" --lat 78.92808 --lon 11.87239
        --date 2026-02-25 --time 08:56:07 --objects "${objects}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Selection ${objects} failed")
    endif()
    foreach(body Sun Moon)
        string(FIND "${output}" "${body} @" found)
        if(body STREQUAL "Sun")
            set(expected ${sun})
        else()
            set(expected ${moon})
        endif()
        if((expected AND found EQUAL -1) OR (NOT expected AND NOT found EQUAL -1))
            message(FATAL_ERROR "Wrong ${body} visibility for ${objects}")
        endif()
    endforeach()
    string(FIND "${output}" "Daily events" events)
    if((sun AND events EQUAL -1) OR (NOT sun AND NOT events EQUAL -1))
        message(FATAL_ERROR "Wrong daily event visibility for ${objects}")
    endif()
endfunction()
run_case(sun TRUE FALSE)
run_case(moon FALSE TRUE)
run_case(sun,moon TRUE TRUE)
run_case(moon,sun TRUE TRUE)
run_case(moon,moon FALSE TRUE)
foreach(value "" "mars" "sun," ",moon" "sun,,moon")
    execute_process(COMMAND "${ASTRO}" --objects "${value}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid selection accepted: ${value}")
    endif()
endforeach()
execute_process(COMMAND "${ASTRO}" --objects sun --objects moon
    RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(result EQUAL 0)
    message(FATAL_ERROR "Repeated --objects accepted")
endif()
